<svg
  class="babki-logo"
  viewBox="0 0 320 320"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Бабки"
>
  <defs>
    <linearGradient id="hatBody" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#403b3a"/>
      <stop offset="55%" stop-color="#292626"/>
      <stop offset="100%" stop-color="#1e1c1c"/>
    </linearGradient>

    <linearGradient id="brim" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4a4543"/>
      <stop offset="100%" stop-color="#242121"/>
    </linearGradient>

    <linearGradient id="coinGold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f5c85b"/>
      <stop offset="50%" stop-color="#d99a25"/>
      <stop offset="100%" stop-color="#a96d13"/>
    </linearGradient>

    <linearGradient id="coinSilver" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#d8d5cd"/>
      <stop offset="100%" stop-color="#85817b"/>
    </linearGradient>

    <filter id="shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="7"/>
    </filter>

    <clipPath id="hatOpening">
      <ellipse cx="160" cy="83" rx="112" ry="43"/>
    </clipPath>
  </defs>

  <!-- мягкая тень -->
  <ellipse
    cx="160"
    cy="277"
    rx="112"
    ry="18"
    fill="#000"
    opacity=".16"
    filter="url(#shadow)"
  />

  <!-- нижняя часть цилиндра -->
  <path
    d="M64 86
       C67 132 70 197 77 236
       C84 268 116 278 160 278
       C204 278 236 268 243 236
       C250 197 253 132 256 86
       Z"
    fill="url(#hatBody)"
    stroke="#181616"
    stroke-width="4"
  />

  <!-- потёртости на цилиндре -->
  <path
    d="M91 137 C105 132 116 133 126 138"
    fill="none"
    stroke="#625b56"
    stroke-width="4"
    opacity=".45"
  />

  <path
    d="M202 156 C217 151 226 153 235 160"
    fill="none"
    stroke="#625b56"
    stroke-width="4"
    opacity=".4"
  />

  <path
    d="M102 218 C117 214 126 216 136 221"
    fill="none"
    stroke="#625b56"
    stroke-width="3"
    opacity=".4"
  />

  <!-- красный шарф -->
  <path
    d="M68 199
       C96 218 124 224 159 224
       C197 224 226 215 251 196
       L254 223
       C226 243 196 249 160 249
       C122 249 91 240 66 220
       Z"
    fill="#813f36"
    stroke="#3d2724"
    stroke-width="4"
  />

  <!-- складки шарфа -->
  <path
    d="M82 216 C118 232 191 239 237 213"
    fill="none"
    stroke="#a55a4c"
    stroke-width="5"
    opacity=".55"
  />

  <path
    d="M88 226 C126 239 191 242 225 222"
    fill="none"
    stroke="#5e302b"
    stroke-width="4"
    opacity=".7"
  />

  <!-- хвост шарфа -->
  <path
    d="M78 215
       C61 223 51 237 46 252
       C59 250 74 244 87 232
       Z"
    fill="#813f36"
    stroke="#3d2724"
    stroke-width="4"
  />

  <!-- голубая заплатка -->
  <path
    d="M207 202 L232 193 L244 216 L224 230 L204 221 Z"
    fill="#536878"
    stroke="#292b2d"
    stroke-width="3"
  />

  <!-- стежки голубой заплатки -->
  <path
    d="M207 202 L232 193 L244 216 L224 230 L204 221 Z"
    fill="none"
    stroke="#c29b75"
    stroke-width="2"
    stroke-dasharray="5 5"
  />

  <!-- красная заплатка -->
  <path
    d="M70 131 L92 120 L110 137 L96 165 L72 158 Z"
    fill="#9b4f40"
    stroke="#302322"
    stroke-width="3"
  />

  <path
    d="M70 131 L92 120 L110 137 L96 165 L72 158 Z"
    fill="none"
    stroke="#c59a72"
    stroke-width="2"
    stroke-dasharray="5 5"
  />

  <!-- основание цилиндра -->
  <ellipse
    cx="160"
    cy="256"
    rx="88"
    ry="21"
    fill="#282424"
    stroke="#171515"
    stroke-width="4"
  />

  <!-- широкие поля шляпы -->
  <ellipse
    cx="160"
    cy="88"
    rx="137"
    ry="54"
    fill="url(#brim)"
    stroke="#181616"
    stroke-width="5"
  />

  <!-- внутренность шляпы -->
  <ellipse
    cx="160"
    cy="81"
    rx="115"
    ry="43"
    fill="#171616"
    stroke="#0f0e0e"
    stroke-width="4"
  />

  <!-- деньги внутри -->
  <g clip-path="url(#hatOpening)">

    <!-- купюра слева -->
    <path
      d="M82 87 L107 49 L154 66 L137 108 Z"
      fill="#a9b99b"
      stroke="#596552"
      stroke-width="2"
      transform="rotate(-8 120 80)"
    />

    <text
      x="110"
      y="78"
      font-size="15"
      font-family="Arial, sans-serif"
      font-weight="bold"
      fill="#596552"
      transform="rotate(-8 110 78)"
    >100</text>

    <!-- купюра справа -->
    <path
      d="M177 48 L221 55 L230 103 L185 97 Z"
      fill="#c69a82"
      stroke="#795c50"
      stroke-width="2"
      transform="rotate(8 204 75)"
    />

    <text
      x="194"
      y="78"
      font-size="14"
      font-family="Arial, sans-serif"
      font-weight="bold"
      fill="#795c50"
      transform="rotate(8 194 78)"
    >500</text>

    <!-- купюра сзади -->
    <path
      d="M127 42 L177 37 L183 88 L133 92 Z"
      fill="#7f987e"
      stroke="#526650"
      stroke-width="2"
      transform="rotate(3 155 65)"
    />

    <!-- золотые монеты -->
    <g fill="url(#coinGold)" stroke="#8c5c13" stroke-width="2">

      <circle cx="109" cy="88" r="15"/>
      <circle cx="132" cy="97" r="17"/>
      <circle cx="157" cy="86" r="19"/>
      <circle cx="181" cy="96" r="16"/>
      <circle cx="204" cy="85" r="18"/>
      <circle cx="222" cy="96" r="14"/>

      <circle cx="125" cy="67" r="13"/>
      <circle cx="153" cy="61" r="15"/>
      <circle cx="184" cy="67" r="13"/>
    </g>

    <!-- серебряные монеты -->
    <g fill="url(#coinSilver)" stroke="#66635e" stroke-width="2">
      <circle cx="145" cy="104" r="13"/>
      <circle cx="171" cy="106" r="12"/>
      <circle cx="194" cy="105" r="11"/>
    </g>

    <!-- рубль на монетах -->
    <g
      font-family="Arial, sans-serif"
      font-weight="bold"
      font-size="13"
      text-anchor="middle"
      fill="#8c5c13"
    >
      <text x="157" y="92">₽</text>
      <text x="204" y="91">₽</text>
      <text x="132" y="103">₽</text>
    </g>

  </g>

  <!-- потертые края -->
  <path
    d="M39 87
       C50 70 87 57 121 53
       M199 53
       C235 58 269 71 281 87"
    fill="none"
    stroke="#b19a83"
    stroke-width="5"
    stroke-linecap="round"
    opacity=".55"
  />

  <!-- маленькие потертости -->
  <g
    fill="#c1a98d"
    opacity=".7"
  >
    <circle cx="48" cy="91" r="3"/>
    <circle cx="67" cy="68" r="2"/>
    <circle cx="272" cy="88" r="3"/>
    <circle cx="250" cy="66" r="2"/>
    <circle cx="87" cy="259" r="3"/>
    <circle cx="236" cy="251" r="3"/>
  </g>
</svg>